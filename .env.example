# 專案環境變數與資料庫設定範本 (Zero-Config 開箱即用範本)

# Active Profile 指定 (預設: example_public)
ACTIVE_PROFILE=example_public

# 資料庫 Backend 設定: postgres
DB_BACKEND=postgres

# PostgreSQL 連線設定 (當 DB_BACKEND 為 postgres 時使用；已與 Docker Compose 預設帳密齊平)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cardflow_user
POSTGRES_PASSWORD=cardflow
POSTGRES_DB=cardflow_demo

# C# 回饋引擎服務 URL (Docker 內部通訊預設 http://csharp-api:5000/api/run/rewards；本地運行預設 127.0.0.1)
CSHARP_REWARDS_API_URL=http://127.0.0.1:5000/api/run/rewards
USE_CSHARP_REWARDS_ENGINE=True
