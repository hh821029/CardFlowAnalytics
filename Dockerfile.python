# 1. 使用官方 Python 3.11 輕量級基礎映像檔
FROM python:3.11-slim

# 2. 設定容器內的工作目錄
WORKDIR /app

# 3. 設定 Python 環境變數
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# 4. 複製 requirements.txt 並安裝依賴
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 5. 複製專案程式碼 (受 .dockerignore 排除敏感與產出資料)
COPY . .

# 6. 宣告暴露的 Port (FastAPI 預設 8000)
EXPOSE 8000

# 7. 啟動 FastAPI 服務
CMD ["uvicorn", "api.server:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--timeout-keep-alive", "65"]
